{
  "expo": {
    "name": "ZeroBuff",
    "slug": "zerobuff",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zerobuff",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B0B",
    "ios": {
      "icon": "./assets/images/splash-icon.png",
      "bundleIdentifier": "com.zerobuff.mobile"
    },
    "android": {
      "package": "com.zerobuff.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0B",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-asset",
      "expo-notifications",
      "./plugins/withRestTimer",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.zerobuff.mobile.RestTimer",
          "groupIdentifier": "group.com.zerobuff.mobile",
          "enablePushNotifications": false,
          "frequentUpdates": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8d8d47a0-bdee-475a-a68d-c1ee7b9eaf58"
      }
    },
    "owner": "salvozero4"
  }
}
