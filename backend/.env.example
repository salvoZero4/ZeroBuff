# Local development defaults. Do not reuse these values in a shared or production environment.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=zerobuff_db

DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/zerobuff_db
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5433/zerobuff_test

# Generate a unique value for any shared environment: openssl rand -hex 32
SECRET_KEY=dev-only-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
